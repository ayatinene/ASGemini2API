# Host / Compose settings (kept in .env; never commit .env or .env.runtime).
# Match UID/GID of the host user that ran host-side `asgemini2api login` and owns ./state.
ASGEMINI_UID=1000
ASGEMINI_GID=1000

# Loopback host port bound to container port 8080 (127.0.0.1:<port>:8080).
ASGEMINI_PORT=8080

# Optional image override (e.g., ghcr.io/ayatinene/asgemini2api:v0.1.0).
# ASGEMINI_IMAGE=asgemini2api:local

# --- Runtime service authentication ---
# Provide distinct 24-1024 printable ASCII keys (no spaces).
# Recommended: place local key files inside ./runtime/ (mounted read-only at /inputs)
# and point *_FILE variables to them, or put raw keys in a separate .env.runtime file.
# Set ONLY *_KEY or *_KEY_FILE for each secret, never both.

# Option A (recommended): key files mounted read-only under /inputs from ./runtime/
# ASGEMINI_API_KEY_FILE=/inputs/api_key
# ASGEMINI_ADMIN_KEY_FILE=/inputs/admin_key

# Option B: inline keys (best kept in a separate .env.runtime file)
# ASGEMINI_API_KEY=replace-with-24-to-1024-char-ascii-api-key
# ASGEMINI_ADMIN_KEY=replace-with-distinct-24-to-1024-char-ascii-admin-key

# --- Optional runtime overrides (defaults shown) ---
# Use this deployment's own Google Desktop registration. The file must be owner-only
# and is never a build input. Registration alone does not grant AiCode access.
# ASGEMINI_INPUT_DIR=/inputs
# ASGEMINI_STATE_DIR=/state
# ASGEMINI_OAUTH_CLIENT_FILE=/inputs/oauth-client.json
# ASGEMINI_UNARY_TIMEOUT=15s
# ASGEMINI_STREAM_TIMEOUT=5m
# ASGEMINI_CATALOG_TTL=24h
# ASGEMINI_QUOTA_TTL=30s
# ASGEMINI_MAX_BODY_BYTES=2097152
# ASGEMINI_MAX_IN_FLIGHT=4
